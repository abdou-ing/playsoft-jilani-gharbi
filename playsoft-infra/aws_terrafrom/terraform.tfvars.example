# Copy to terraform.tfvars and adjust.

region       = "eu-central-1"
project      = "k8s-selfmanaged"
cluster_name = "my-cluster"

azs                  = ["eu-central-1a", "eu-central-1b", "eu-central-1c"]
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]

# Fixed private IP for the single master instance (must be inside private_subnet_cidrs[0])
master_private_ip = "10.0.10.10"

# Your baked AMI (kubeadm/containerd pre-installed). Empty = Ubuntu 22.04 for testing.
ami_id = ""

master_instance_type  = "t3.medium"
worker_instance_type  = "t3.large"
bastion_instance_type = "t3.small"

worker_min_size         = 3
worker_max_size         = 6
worker_desired_capacity = 3

# CIDR allowed to SSH the bastion. Set this to your own IP -- never 0.0.0.0/0.
admin_cidr = "203.0.113.10/32"

# The bastion needs a real key pair for SSH agent-forwarding into the cluster.
# Leave empty only if you're relying on SSM Session Manager instead.
ssh_key_name = "my-keypair"

app_nodeport = 30080
