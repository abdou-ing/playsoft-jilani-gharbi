global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /opt/infra/prometheus/config/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        # Alertmanager runs on the bastion (roles/autoscaler), not here --
        # {{ bastion_private_ip }} comes from group_vars/all.yml (tf_output.json).
        - targets: ['{{ bastion_private_ip }}:9093']

scrape_configs:
  - job_name: k8s-nodes
    file_sd_configs:
      - files:
          - /opt/infra/prometheus/config/targets.json
        refresh_interval: 30s
