# Copy to terraform.tfvars and adjust.

region       = "us-east-1"
project      = "jilani-k8s-eks"
cluster_name = "guacamole"

kubernetes_version = "1.31"

vpc_cidr             = "10.30.0.0/16"
azs                  = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.30.0.0/24", "10.30.1.0/24"]
private_subnet_cidrs = ["10.30.10.0/24", "10.30.11.0/24"]

# CIDR allowed to reach the EKS public API endpoint + node SSH.
# Set this to your own IP -- never 0.0.0.0/0.
admin_cidr = "203.0.113.10/32"

# Leave empty to disable SSH access to nodes (SSM Session Manager still works
# either way via the node role's AmazonSSMManagedInstanceCore policy).
ssh_key_name = "jilani"

# IAM roles this stack does NOT create -- jilani can't create IAM roles,
# Abdallah does. Referenced by name (not ARN) since jilani only has
# iam:PassRole on them, not iam:GetRole -- the ARN is built from the name +
# account ID. cluster_role_name/node_role_name must exist before the first
# apply. ebs_csi_role_arn/lb_controller_role_arn only exist after that
# apply gives you a real OIDC issuer (terraform output
# cluster_oidc_issuer_url) -- leave them empty the first time around.
cluster_role_name      = ""
node_role_name         = ""
ebs_csi_role_arn       = ""
lb_controller_role_arn = ""

node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
node_disk_size      = 40
